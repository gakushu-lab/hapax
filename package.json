    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@hono/node-server": "^2.1.5",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@digital-go-jp/design-tokens": "2.0.1",
    "@digital-go-jp/tailwind-theme-plugin": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
