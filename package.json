{
  "name": "hapax",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hapax/web dev",
    "api": "pnpm --filter @hapax/api dev",
    "db-init": "pnpm --filter @hapax/api db-init",
    "build": "pnpm --filter @hapax/web build",
    "build-api": "pnpm --filter @hapax/api build",
    "test": "pnpm -r run test",
    "e2e": "pnpm --filter @hapax/e2e e2e",
    "check-types": "pnpm -r run check-types",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxlint": "^1.88.0"
  },
  "packageManager": "pnpm@12.6.0"
}
