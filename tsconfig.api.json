{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    // src/lib/crypto.ts の CryptoKey などブラウザと共通の型を使う
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "api",
    "scripts",
    "shared",
    "test",
    "src/lib/base64url.ts",
    "src/lib/crypto.ts",
    "src/lib/fragment.ts"
  ]
}
